  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@hono/node-server": "^2.0.12",
    "@ludiars/canalis": "file:./lib/canalis",
    "@ludiars/llm-gateway": "file:./lib/lapilli/packages/llm-gateway",
    "@ludiars/one-shot": "file:lib/lapilli/packages/one-shot",
    "@ludiars/sentiment-core": "file:./lib/lapilli/packages/sentiment-core",
    "better-sqlite3": "13.0.3",
    "discord.js": "^14.27.0",
    "fundamentum": "file:./lib/fundamentum",
    "gray-matter": "^4.0.3",
    "hono": "^4.8.3",
    "kuzu": "^0.11.3",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "tar": "^7.5.20",
    "zod": "^3.25.76"
  },
  "overrides": {
    "cmake-js": "8.0.0",
    "tar": "$tar",
    "undici": "6.27.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "tsx": "^4.20.3",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
