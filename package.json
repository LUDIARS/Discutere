{
  "name": "discutere",
  "version": "0.1.0",
  "description": "Discutere — 遊びの議論プラットフォーム (Discatier): Discord-only の自走議論 ChatBot",
  "type": "module",
  "productName": "Discutere",
  "scripts": {
    "setup:submodules": "node scripts/setup-submodules.mjs",
    "check:sentiment-assets": "node scripts/check-sentiment-assets.mjs",
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "build:learning-cache": "tsx scripts/build-learning-cache.ts",
    "build:conclusion-cache": "tsx scripts/build-conclusion-cache.ts",
    "build:voice-embeddings": "tsx scripts/build-voice-embeddings.ts",
    "build:ludus-term-aliases": "tsx scripts/build-ludus-term-aliases.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "learning-viewer": "tsx scripts/learning-viewer.ts",
    "test:core": "tsx tests/core/run.ts",
    "test:ft": "tsx tests/ft/quality-filter.test.ts",
    "test:eval": "tsx tests/eval/relevance-judge.test.ts",
    "test:phase3": "tsx tests/core/bridge/translation/run.ts",
    "test:phase4": "tsx tests/core/bridge/gap/run.ts",
    "test:crawler": "tsx tests/crawler/run.ts",
    "test:visualize": "tsx tests/visualize/run.ts",
    "test:persona-engine": "tsx tests/persona-engine/run.ts",
    "test:discord-hook": "tsx tests/discord-hook/run.ts",
    "test:mechanics-check": "tsx tests/mechanics-check/run.ts",
    "test:level-check": "tsx tests/level-check/run.ts",
    "test:backup": "tsx tests/backup/run.ts",
    "test:fundamentum-export": "tsx tests/fundamentum-export/run.ts",
    "crawl": "tsx scripts/crawl.ts",
    "steam-persona": "tsx scripts/steam-persona.ts",
    "comment-history": "tsx scripts/comment-history.ts",
    "test:comment-history": "tsx --test tests/crawler/comment-history.test.ts",
    "export:discussions": "tsx scripts/export-discussion.ts",
    "export:discussions:fm": "tsx scripts/export-discussion.ts --fundamentum",
    "cost-report": "tsx scripts/cost-report.ts",
    "cost-relay": "tsx scripts/cost-relay.ts",
    "visualize": "tsx scripts/visualize.ts",
    "persona-demo": "tsx scripts/persona-engine-demo.ts",
    "seed:affects": "tsx scripts/seed-affects.ts",
    "import:sentiment": "tsx scripts/import-sentiment.ts",
