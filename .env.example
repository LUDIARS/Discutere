# Discutere — Discord 議論モードで動かす最小 env サンプル
# Cernere / Infisical / frontend は **不要** (= dev では X-User-* ヘッダーで admin になれる)。
#
# 設定は config ファイル (discutere.config.json, discutere.config.example.json 参照) に
# 集約できる。優先順は default < config ファイル < env。env は CI / 秘密情報の上書き用。
# config ファイルパスは DISCUTERE_CONFIG で変更可 (既定 ./discutere.config.json)。

# ─── 必須 ──────────────────────────────────────────────
NODE_ENV=development             # production にすると起動時 health guard が走る (botToken 必須等、src/startup-guard.ts)
BACKEND_PORT=3110             # 3100 は Nuntius backend が使用するため 3110 へ退避 (PORT-MAP)

# 議論 workspace + safety caps
DISCATIER_WORKSPACE=knowledge
PERSONA_ENGINE_MAX_FIRES_PER_SESSION=20
PERSONA_ENGINE_MAX_FIRES_PER_RULE=5
PERSONA_ENGINE_TICK_MS=5000
PERSONA_ENGINE_BRIDGE_POLL_MS=2000

# ─── LLM backend (どちらか) ────────────────────────────
LLM_BACKEND=claude-cli           # (a) Lictor 経由 spawn (claude CLI 必須、 API key 不要)
# LLM_BACKEND=anthropic            # (b) Anthropic SDK 直叩き
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CLI_TIMEOUT_MS=120000

# ─── Discord Gateway (WS 接続) ─────────────────────────
# WS 再設計: bot token で Gateway に常時接続する (公開 URL / 署名検証エンドポイント不要)。
# 未設定なら Gateway は skip 起動 (HTTP health 等は従来通り)。
DISCUTERE_DISCORD_BOT_TOKEN=     # bot token (空なら Gateway 無効)
# DISCUTERE_DISCORD_APPLICATION_ID=  # slash command 自動登録に使用 (未設定なら client.application.id)
# 運用 guild id 群 (カンマ区切り、複数サーバ対応)。空なら global 登録 + monitor カードなし。
# DISCUTERE_DISCORD_GUILD_IDS=g1,g2
# DISCUTERE_DISCORD_GUILD_ID=        # (後方互換) 旧 単数。GUILD_IDS に統合される
DISCUTERE_DISCORD_ADMIN_IDS=     # カンマ区切り Discord user id (空なら admin slash 拒否)
# 平文メッセージを utterance 取り込みする議論チャンネル id (カンマ区切り、空なら取り込まない)
# 許可チャンネルでは slash なしで全平文を議論に取り込む。スレッドは親が許可なら継承。
DISCUTERE_DISCORD_DISCUSSION_CHANNELS=

# ─── 学習データ S3 バックアップ (月次自動 + 手動 slash/script) ──────
# enabled=1 かつ bucket 設定で月次自動。手動は `npm run backup` / /discutere-backup。
# DISCUTERE_BACKUP_ENABLED=1
# DISCUTERE_BACKUP_BUCKET=my-discutere-archive
# DISCUTERE_BACKUP_REGION=ap-northeast-1
# DISCUTERE_BACKUP_PREFIX=discutere/
# DISCUTERE_BACKUP_STORAGE_CLASS=GLACIER   # Glacier 系で安価アーカイブ (STANDARD も可)
# DISCUTERE_BACKUP_INTERVAL_DAYS=30        # 既定 30 = 月次
# DISCUTERE_BACKUP_ENDPOINT=               # MinIO 等の S3 互換 (任意)
# AWS_ACCESS_KEY_ID=                       # 未設定なら AWS SDK 既定チェーン (IAM ロール等)
# AWS_SECRET_ACCESS_KEY=

# ─── 任意: CORS / frontend (議論機能のみなら未設定 OK) ─
# FRONTEND_URL=http://localhost:5174

# ─── Cernere Composite (production の本格認証時のみ) ───
# CERNERE_URL=http://localhost:8080
# CERNERE_PROJECT_CLIENT_ID=
# CERNERE_PROJECT_CLIENT_SECRET=
