# Discutere — Discord 議論モードで動かす最小 env サンプル
# Cernere / Infisical / frontend は **不要** (= dev では X-User-* ヘッダーで admin になれる)。

# ─── 必須 ──────────────────────────────────────────────
NODE_ENV=development             # production にすると JWT_SECRET 強度 guard が走る
BACKEND_PORT=3100
JWT_SECRET=dev-secret-32chars-anything-ok-in-dev  # dev は任意、 production は >= 32 文字 & default 不可

# 議論 workspace + safety caps
DISCATIER_WORKSPACE=knowledge
PERSONA_ENGINE_MAX_FIRES_PER_SESSION=20
PERSONA_ENGINE_MAX_FIRES_PER_RULE=5
PERSONA_ENGINE_TICK_MS=5000
PERSONA_ENGINE_BRIDGE_POLL_MS=2000

# ─── LLM backend (どちらか) ────────────────────────────
LLM_BACKEND=claude-cli           # (a) Lictor 経由 spawn (claude CLI 必須、 API key 不要)
# LLM_BACKEND=anthropic            # (b) Anthropic SDK 直叩き
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CLI_TIMEOUT_MS=120000

# ─── Discord (kill switch slash の認可) ────────────────
DISCUTERE_DISCORD_ADMIN_IDS=     # カンマ区切り Discord user id (空なら admin slash 拒否)

# ─── 任意: CORS / frontend (議論機能のみなら未設定 OK) ─
# FRONTEND_URL=http://localhost:5174

# ─── Cernere Composite (production の本格認証時のみ) ───
# CERNERE_URL=http://localhost:8080
# CERNERE_PROJECT_CLIENT_ID=
# CERNERE_PROJECT_CLIENT_SECRET=

# ─── MACHINA (Chat-to-Task) 関連 (議論モードでは不要) ──
# HAIKU_MODEL=claude-haiku-4-5-20251001
# GITHUB_TOKEN=
# LUDUS_LEARNER_ENABLED=1
# DISCUTERE_TASK_SESSION_TTL_MS=86400000
# DISCUTERE_DISCUSSION_SESSION_TTL_MS=86400000
