# lorica_applied.compile_commands: compile_commands.json の全エントリのうち Discutere のビルド単位 (di_* と discutere-server)
# について、Lorica が付けるフラグが入っていて、打ち消すフラグが無いことを確かめる (cmake -P。Python に頼らない)。
# 引数は tests/lorica_applied/CMakeLists.txt が -D で渡す:
#   COMPILE_COMMANDS  compile_commands.json の場所
#   SKIP_REASON       空でなければ「見られない」ことを出して skip (ctest の SKIP_REGULAR_EXPRESSION が拾う)
#   TOOLCHAIN         linux / msvc / unsupported
#   CONFIG            単一構成の build type (複数構成の generator では空)
#   SERVER_PROFILE    extended / baseline (SERVER のビルド単位の profile)
#   SERVER_TARGETS    SERVER で作るビルド単位 (カンマ区切り)
#   LINUX_FLAGS       <言語>:<フラグ> の、全ビルド単位に求める baseline のフラグ (カンマ区切り)
#   FORTIFY           最適化ありの構成で Lorica が付ける _FORTIFY_SOURCE の値
#   UNSAFE_API        1 なら C++ のビルド単位に unsafe API の拒否 (強制 include / /we4996) を求める
#   UNSAFE_API_HEADER 強制 include される lorica/unsafe_api.hpp の実パス
#   SOURCE_DIR        native/ (ここの src/ と tests/ のソースは、必ず Discutere のビルド単位に入っていること)
cmake_minimum_required(VERSION 3.24)

if(NOT "${SKIP_REASON}" STREQUAL "")
  message("LORICA_APPLIED_SKIP: compile_commands.json を見られない: ${SKIP_REASON}")
  return()
endif()
if(TOOLCHAIN STREQUAL "unsupported")
  message("LORICA_APPLIED_SKIP: Lorica が対応しないツールチェインなので、守りのフラグを確かめられない")
  return()
endif()
if(NOT EXISTS "${COMPILE_COMMANDS}")
  message(FATAL_ERROR "${COMPILE_COMMANDS} が無い (CMAKE_EXPORT_COMPILE_COMMANDS=ON で configure したか)")
endif()

string(REPLACE "," ";" SERVER_TARGETS "${SERVER_TARGETS}")
string(REPLACE "," ";" LINUX_FLAGS "${LINUX_FLAGS}")
set(optimized FALSE)
string(TOUPPER "${CONFIG}" config_upper)
if(config_upper MATCHES "^(RELEASE|RELWITHDEBINFO|MINSIZEREL)$")
  set(optimized TRUE)
endif()

file(READ "${COMPILE_COMMANDS}" json)
string(JSON count LENGTH "${json}")
if(count EQUAL 0)
  message(FATAL_ERROR "${COMPILE_COMMANDS} にエントリが無い")
endif()

# tokens の中で、name に一致する最後のトークンの位置 (無ければ -1)。
function(_last_index out regex)
  set(index -1)
  set(i 0)
  foreach(token IN LISTS ARGN)
    if(token MATCHES "${regex}")
      set(index ${i})
    endif()
    math(EXPR i "${i} + 1")
  endforeach()
  set(${out} ${index} PARENT_SCOPE)
endfunction()

set(failures "")
set(failed_count 0)
set(checked 0)
set(checked_c 0)
set(checked_server 0)
set(ignored 0)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
  string(JSON entry GET "${json}" ${i})
  string(JSON file GET "${entry}" file)
  string(JSON output ERROR_VARIABLE no_output GET "${entry}" output)
  string(JSON command ERROR_VARIABLE no_command GET "${entry}" command)
  if(no_command)
    # "arguments" 形式 (配列)。
    set(command "")
    string(JSON nargs LENGTH "${entry}" arguments)
    math(EXPR nlast "${nargs} - 1")
    set(tokens "")
    foreach(j RANGE ${nlast})
      string(JSON arg GET "${entry}" arguments ${j})
      list(APPEND tokens "${arg}")
    endforeach()
  elseif(TOOLCHAIN STREQUAL "msvc")
    separate_arguments(tokens WINDOWS_COMMAND "${command}")
  else()
    separate_arguments(tokens UNIX_COMMAND "${command}")
  endif()
  file(TO_CMAKE_PATH "${file}" file)
  file(TO_CMAKE_PATH "${output}" output)

  set(target "")
  if(output MATCHES "(^|/)CMakeFiles/([^/]+)\\.dir/")
    set(target "${CMAKE_MATCH_2}")
  endif()
  if(NOT target MATCHES "^(di_[A-Za-z0-9_]+|discutere-server)$")
    string(FIND "${file}" "${SOURCE_DIR}/src/" in_src)
    string(FIND "${file}" "${SOURCE_DIR}/tests/" in_tests)
    if(in_src EQUAL 0 OR in_tests EQUAL 0)
      list(APPEND failures "${file}: Discutere のソースが Discutere のビルド単位以外 ('${target}') でコンパイルされている")
      math(EXPR failed_count "${failed_count} + 1")
    else()
      math(EXPR ignored "${ignored} + 1")
    endif()
    continue()
  endif()

  set(lang CXX)
  if(file MATCHES "\\.c$")
    set(lang C)
  endif()
  set(server FALSE)
  if(target IN_LIST SERVER_TARGETS)
    set(server TRUE)
  endif()
  set(extended FALSE)
  if(server AND SERVER_PROFILE STREQUAL "extended")
    set(extended TRUE)
  endif()

  set(missing "")
  if(TOOLCHAIN STREQUAL "linux")
    # baseline のフラグ (Lorica が付けるもの)。後ろの打ち消しを見るため、同じ系統の最後のトークンが期待どおりかを見る。
    foreach(item IN LISTS LINUX_FLAGS)
      if(NOT item MATCHES "^${lang}:(.*)$")
        continue()
      endif()
      set(flag "${CMAKE_MATCH_1}")
      if(flag STREQUAL "-fstack-protector-strong")
        _last_index(at "^-f(no-)?stack-protector(-.*)?$" ${tokens})
        set(ok_regex "^-fstack-protector-(strong|all)$")
      elseif(flag STREQUAL "-fstack-clash-protection")
        _last_index(at "^-f(no-)?stack-clash-protection$" ${tokens})
        set(ok_regex "^-fstack-clash-protection$")
      elseif(flag MATCHES "^-fcf-protection")
        _last_index(at "^-f(no-)?cf-protection(=.*)?$" ${tokens})
        set(ok_regex "^-fcf-protection=full$")
      elseif(flag MATCHES "^-mbranch-protection")
        _last_index(at "^-mbranch-protection=" ${tokens})
        set(ok_regex "^-mbranch-protection=standard$")
      else()
        _last_index(at "^${flag}$" ${tokens})
        set(ok_regex "^${flag}$")
      endif()
      if(at LESS 0)
        list(APPEND missing "${flag} が無い")
      else()
        list(GET tokens ${at} token)
        if(NOT token MATCHES "${ok_regex}")
          list(APPEND missing "${flag} が ${token} で打ち消されている")
        endif()
      endif()
    endforeach()
    # PIE / PIC (POSITION_INDEPENDENT_CODE)。
    _last_index(at "^-f(no-)?(PIC|PIE|pic|pie)$" ${tokens})
    if(at LESS 0)
      list(APPEND missing "-fPIC / -fPIE が無い")
    else()
      list(GET tokens ${at} token)
      if(token MATCHES "^-fno-")
        list(APPEND missing "位置独立が ${token} で打ち消されている")
      endif()
    endif()
    # _FORTIFY_SOURCE (最適化ありの構成だけ)。
    _last_index(at_u "^-U_FORTIFY_SOURCE$" ${tokens})
    _last_index(at_d "^-D_FORTIFY_SOURCE(=.*)?$" ${tokens})
    if(at_d GREATER_EQUAL 0)
      list(GET tokens ${at_d} token)
      if(token MATCHES "^-D_FORTIFY_SOURCE=0$")
        list(APPEND missing "-D_FORTIFY_SOURCE=0 がある")
      endif()
    endif()
    if(optimized AND FORTIFY GREATER 0)
      if(at_d LESS 0)
        list(APPEND missing "-D_FORTIFY_SOURCE=${FORTIFY} が無い")
      elseif(NOT token STREQUAL "-D_FORTIFY_SOURCE=${FORTIFY}")
        list(APPEND missing "_FORTIFY_SOURCE が ${token} (期待は ${FORTIFY})")
      elseif(at_u GREATER at_d)
        list(APPEND missing "-D_FORTIFY_SOURCE=${FORTIFY} の後に -U_FORTIFY_SOURCE がある")
      endif()
    endif()
    if(extended)
      _last_index(at "^-ftrivial-auto-var-init=" ${tokens})
      if(at LESS 0)
        list(APPEND missing "EXTENDED の -ftrivial-auto-var-init=zero が無い")
      else()
        list(GET tokens ${at} token)
        if(NOT token STREQUAL "-ftrivial-auto-var-init=zero")
          list(APPEND missing "EXTENDED の -ftrivial-auto-var-init=zero が ${token} で打ち消されている")
        endif()
      endif()
    endif()
    if(lang STREQUAL "CXX")
      _last_index(at_d "^-D_GLIBCXX_ASSERTIONS(=1)?$" ${tokens})
      _last_index(at_u "^-U_GLIBCXX_ASSERTIONS$" ${tokens})
      if(at_d LESS 0)
        list(APPEND missing "-D_GLIBCXX_ASSERTIONS が無い")
      elseif(at_u GREATER at_d)
        list(APPEND missing "-D_GLIBCXX_ASSERTIONS が -U_GLIBCXX_ASSERTIONS で打ち消されている")
      endif()
      if(extended)
        set(mode _LIBCPP_HARDENING_MODE_EXTENSIVE)
      else()
        set(mode _LIBCPP_HARDENING_MODE_FAST)
      endif()
      _last_index(at "^-D_LIBCPP_HARDENING_MODE=" ${tokens})
      if(at LESS 0)
        list(APPEND missing "-D_LIBCPP_HARDENING_MODE=${mode} が無い")
      else()
        list(GET tokens ${at} token)
        if(NOT token STREQUAL "-D_LIBCPP_HARDENING_MODE=${mode}")
          list(APPEND missing "_LIBCPP_HARDENING_MODE が ${token} (期待は ${mode})")
        endif()
      endif()
      if(UNSAFE_API)
        set(included FALSE)
        set(previous "")
        foreach(token IN LISTS tokens)
          if(previous STREQUAL "-include")
            file(TO_CMAKE_PATH "${token}" header)
            if(header STREQUAL UNSAFE_API_HEADER)
              set(included TRUE)
            endif()
          endif()
          set(previous "${token}")
        endforeach()
        if(NOT included)
          list(APPEND missing "-include ${UNSAFE_API_HEADER} (unsafe API の拒否) が無い")
        endif()
        _last_index(at_e "^-W(no-)?(error=)?deprecated-declarations$" ${tokens})
        if(at_e LESS 0)
          list(APPEND missing "-Werror=deprecated-declarations が無い")
        else()
          list(GET tokens ${at_e} token)
          if(NOT token STREQUAL "-Werror=deprecated-declarations")
            list(APPEND missing "-Werror=deprecated-declarations が ${token} で打ち消されている")
          endif()
        endif()
      endif()
    endif()
  else()
    # MSVC (cl): baseline は /GS /sdl /guard:cf、EXTENDED は STL の定義、unsafe API の拒否は /we4996。
    foreach(flag /GS /sdl /guard:cf)
      string(REPLACE "/" "" bare "${flag}")
      _last_index(at "^[-/]${bare}-?$" ${tokens})
      if(at LESS 0)
        list(APPEND missing "${flag} が無い")
      else()
        list(GET tokens ${at} token)
        if(token MATCHES "-$")
          list(APPEND missing "${flag} が ${token} で打ち消されている")
        endif()
      endif()
    endforeach()
    if(lang STREQUAL "CXX" AND extended)
      foreach(def _MSVC_STL_HARDENING _MSVC_STL_DESTRUCTOR_TOMBSTONES)
        _last_index(at "^[-/]D${def}=1$" ${tokens})
        if(at LESS 0)
          list(APPEND missing "EXTENDED の ${def}=1 が無い")
        endif()
      endforeach()
    endif()
    if(lang STREQUAL "CXX" AND UNSAFE_API)
      _last_index(at "^[-/]we4996$" ${tokens})
      _last_index(at_off "^[-/](wd|w[1-4])4996$" ${tokens})
      if(at LESS 0)
        list(APPEND missing "/we4996 が無い")
      elseif(at_off GREATER at)
        list(APPEND missing "/we4996 が打ち消されている")
      endif()
      _last_index(at "^[-/]D_CRT_SECURE_NO_WARNINGS(=.*)?$" ${tokens})
      if(at GREATER_EQUAL 0)
        list(APPEND missing "_CRT_SECURE_NO_WARNINGS で UCRT の deprecation が切られている")
      endif()
    endif()
  endif()

  math(EXPR checked "${checked} + 1")
  if(lang STREQUAL "C")
    math(EXPR checked_c "${checked_c} + 1")
  endif()
  if(server)
    math(EXPR checked_server "${checked_server} + 1")
  endif()
  if(missing)
    list(JOIN missing "; " missing_text)
    list(APPEND failures "${file} (${target}, ${lang}): ${missing_text}")
    math(EXPR failed_count "${failed_count} + 1")
  endif()
endforeach()

message("compile_commands.json: ${count} 件。Discutere のビルド単位 ${checked} 件 (うち C ${checked_c} 件、"
  "SERVER ${checked_server} 件、SERVER の profile=${SERVER_PROFILE}) を確認、第三者 ${ignored} 件は対象外")
if(checked_c EQUAL 0 AND TOOLCHAIN STREQUAL "linux")
  list(APPEND failures "C のビルド単位 (di_sqlite) のエントリが 1 件も無い")
  math(EXPR failed_count "${failed_count} + 1")
endif()
if(failed_count GREATER 0)
  list(JOIN failures "\n  " failures_text)
  message(FATAL_ERROR "Lorica の守りが欠けているエントリが ${failed_count} 件:\n  ${failures_text}")
endif()
