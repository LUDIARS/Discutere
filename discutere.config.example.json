{
  "$comment": "Discutere サービス固有 config の例。`discutere.config.json` にコピーして使う (DISCUTERE_CONFIG で別パス指定可)。優先順: default < このファイル < env。秘密情報 (bot token / API key) は env での上書きを推奨。",
  "server": {
    "port": 3100,
    "frontendUrl": "http://localhost:5174"
  },
  "workspace": "knowledge",
  "discatier": {
    "kuzuPath": "./data/discatier.kuzu"
  },
  "flow": {
    "$comment": "autoCrawl: 議論/改善の開始時にテーマの学習データが不足していたら指定ソースで自動クロール→KG取込してから議論する (事前学習のUI化)。UI(/flow)で議論ごとに source/query/appId/urls を上書きでき、ここはその既定値。source は niconico|youtube|steam|website。",
    "autoCrawl": {
      "enabled": true,
      "source": "niconico",
      "minVoices": 3,
      "maxItems": 200
    },
    "$comment2": "informationGating: 議論/改善の開始前に LLM が情報密度(sparse/moderate/rich)と不足観点を評価し、不足なら不足観点を狙って学習→再評価する情報ゲート。自動モード固定(不足なら自動学習→十分になり次第そのまま議論を開始)。enabled=false で従来の autoCrawl(単純カウント閾値)にフォールバック。クロールのソース/maxItems は autoCrawl の設定を流用する。",
    "informationGating": {
      "enabled": true,
      "minDensity": "moderate",
      "maxLearnIterations": 2,
      "maxGapsPerIteration": 2,
      "model": ""
    }
  },
  "personaEngine": {
    "dbPath": "./data/persona-engine.db",
    "maxFiresPerSession": 20,
    "maxFiresPerRule": 5,
    "tickMs": 5000,
    "bridgePollMs": 2000
  },
  "llm": {
    "backend": "claude-cli",
    "anthropicApiKey": "",
    "model": "",
    "claudeCliTimeoutMs": 120000,
    "gitBashPath": "",
    "local": {
      "baseUrl": "http://localhost:11434/v1",
      "model": "gemma4:12b",
      "apiKey": "",
      "timeoutMs": 120000
    }
  },
  "classifier": {
    "backend": "claude-cli",
    "model": "claude-haiku-4-5-20251001",
    "timeoutMs": 30000
  },
  "discussion": {
    "expectedUtterances": 20,
    "keymanCount": 2,
    "facilitatorModel": "claude-opus-4-8",
    "keymanModel": "claude-opus-4-8",
    "opinionModels": [
      { "model": "claude-sonnet-4-6", "weight": 6 },
      { "model": "claude-haiku-4-5-20251001", "weight": 4 }
    ],
    "minTotal": 4,
    "turnDelayMs": 4000,
    "continueTimeoutMs": 120000,
    "maxRounds": 5
  },
  "discord": {
    "botToken": "",
    "applicationId": "",
    "guildIds": [],
    "adminIds": [],
    "discussionChannelIds": [],
    "crawlChannelIds": [],
    "forum": {
      "enabled": true,
      "summaryChannelName": "まとめ投稿",
      "dataLearningChannelName": "データ学習依頼",
      "managedCategoryName": "システム",
      "improvementTagNames": ["改善提案", "改善", "提案", "improvement"],
      "funTagNames": ["面白さ", "面白い", "おもしろさ", "fun"]
    },
    "gameFeedback": {
      "enabled": true,
      "categoryName": "ゲーム感想"
    }
  },
  "slack": {
    "enabled": false,
    "appToken": "",
    "botToken": "",
    "channelIds": [],
    "adminIds": []
  },
  "backup": {
    "enabled": false,
    "bucket": "",
    "region": "ap-northeast-1",
    "prefix": "discutere/",
    "storageClass": "GLACIER",
    "endpoint": "",
    "intervalDays": 30,
    "stateFile": "./data/backup-state.json"
  }
}
